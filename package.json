{
  "name": "intentproof",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A merchant-controlled policy gateway for AI payment agents.",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "npm run build:server && npm run build:frontend",
    "build:server": "tsc -p tsconfig.json",
    "build:frontend": "vite build",
    "dev": "tsx watch src/server.ts",
    "dev:frontend": "vite --host 127.0.0.1 --port 4173 --strictPort",
    "preview:frontend": "vite preview --host 127.0.0.1 --port 4173 --strictPort",
    "start": "tsx src/server.ts",
    "gateway": "tsx src/gateway/stdio.ts",
    "probe:upstream": "tsx src/cli/probe-upstream.ts",
    "probe:gateway": "tsx src/cli/probe-gateway.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "export:ledger": "tsx src/cli/export-ledger.ts",
    "verify:ledger": "tsx src/cli/verify-ledger.ts",
    "lab": "tsx src/cli/lab.ts",
    "mandate": "tsx src/cli/mandate.ts",
    "agent": "tsx src/cli/demo-agent.ts",
    "planner:demo": "tsx src/cli/planner-demo.ts",
    "planner:smoke": "tsx src/cli/planner-smoke.ts",
    "webhook:evidence": "tsx src/cli/export-webhook-evidence.ts",
    "evidence": "tsx src/cli/evidence.ts",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@modelcontextprotocol/client": "2.0.0",
    "@modelcontextprotocol/server": "2.0.0",
    "better-sqlite3": "13.0.3",
    "dotenv": "17.4.2",
    "express": "5.2.1",
    "lucide-react": "1.41.0",
    "pino": "10.3.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "yaml": "2.9.0",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/better-sqlite3": "9.6.0",
    "@types/express": "5.0.6",
    "@types/node": "26.4.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@types/supertest": "7.2.1",
    "@vitejs/plugin-react": "6.1.1",
    "jsdom": "30.0.1",
    "supertest": "7.2.2",
    "tsx": "4.23.13",
    "typescript": "7.0.2",
    "vite": "8.2.2",
    "vitest": "4.1.11"
  }
}
