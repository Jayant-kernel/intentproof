  "proposed_version": 1,
  "source_text": "Create orders up to 3,000 rupees.\nKeep total action value under 25,000 rupees per day, with no more than 200 actions.\nDo not capture a payment until delivery is confirmed.\nAsk me before capturing more than 2,000 rupees.\nDo not act between 10pm and 8am.",
  "rules": {
    "constraints": [
      {
        "id": "C1",
        "quote": "Create orders up to 3,000 rupees.",
        "rule": "tool_allowlist",
        "tools": ["create_order", "create_payment_link", "capture_payment"]
      },
      {
        "id": "C2",
        "quote": "Create orders up to 3,000 rupees.",
        "rule": "amount_ceiling",
        "tool": "create_order",
        "max_paise": 300000
      },
      {
        "id": "C3",
        "quote": "Do not capture a payment until delivery is confirmed.",
        "rule": "precondition",
        "tool": "capture_payment",
        "assert": "delivery_confirmed",
        "on_unknown": "ABSTAIN"
      },
      {
        "id": "C4",
        "quote": "Ask me before capturing more than 2,000 rupees.",
        "rule": "approval_gate",
        "tool": "capture_payment",
        "above_paise": 200000,
        "timeout_seconds": 900
      },
      {
        "id": "C5",
        "quote": "Do not act between 10pm and 8am.",
        "rule": "time_window",
        "allowed": "08:00-22:00",
        "timezone": "Asia/Kolkata"
      }
    ],
    "budgets": [
      {
        "window": "24h",
        "tool": "*",
        "max_total_paise": 2500000,
        "max_calls": 200,
        "quote": "Keep total action value under 25,000 rupees per day, with no more than 200 actions."
      }
    ]
  },
